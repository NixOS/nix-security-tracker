from typing import Any

class Fragment:
    def __init__(self, typ: Any, name: str) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class Operation:
    def __init__(self, typ: Any, name: str | None = None, **args: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def __add__(self, other: Any) -> Any: ...
